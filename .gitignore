# Dependency and generated frontend output
**/node_modules/
**/.next/
**/storybook-static/

# Python environments and caches
**/.venv/
**/**pycache**/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.pyc

# Local environment and secrets
**/.env
**/.env.local
**/.env.production
**/.env.*.local
!**/.env.example
!**/.env.*.example

# Databases and sidecar files
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite3

# Deployment secrets: keep only examples and documentation
**/deploy/secrets/*
!**/deploy/secrets/*.example
!**/deploy/secrets/README.md
!**/deploy/secrets/.gitkeep

# Private keys and certificate bundles
**/*.pem
**/*.key
**/*.pfx
**/*.p12

# Coverage, build output and caches
**/coverage/
**/.coverage
**/dist/
**/build/
**/tsconfig.tsbuildinfo

# Operating system and editor noise
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
**/.idea/
**/.vscode/
