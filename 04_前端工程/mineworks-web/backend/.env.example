MINEWORKS_APP_NAME=MineWorks API
MINEWORKS_APP_VERSION=1.1.0
MINEWORKS_ENVIRONMENT=development
MINEWORKS_API_PREFIX=/api/v1
MINEWORKS_PUBLIC_ORIGIN=http://127.0.0.1:3000
MINEWORKS_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
MINEWORKS_TRUSTED_HOSTS=127.0.0.1,localhost,testserver

# Local development keeps SQLite. Production must use postgresql+psycopg://...
MINEWORKS_DATABASE_URL=
# Production can mount a Docker/Kubernetes secret containing the complete URL.
MINEWORKS_DATABASE_URL_FILE=
MINEWORKS_DATABASE_PATH=data/mineworks.db
MINEWORKS_DATABASE_POOL_SIZE=5
MINEWORKS_DATABASE_MAX_OVERFLOW=10
MINEWORKS_AUTO_CREATE_SCHEMA=true

MINEWORKS_ALLOW_SELF_REGISTRATION=true
MINEWORKS_INVITATION_TTL_HOURS=72
MINEWORKS_SESSION_TTL_HOURS=168
MINEWORKS_SESSION_IDLE_MINUTES=120
MINEWORKS_SESSION_COOKIE_NAME=mw_session
MINEWORKS_CSRF_COOKIE_NAME=mw_csrf
MINEWORKS_COOKIE_SECURE=false
MINEWORKS_COOKIE_SAMESITE=lax
MINEWORKS_COOKIE_DOMAIN=
MINEWORKS_ALLOW_BEARER_TOKENS=true
MINEWORKS_CSRF_ENABLED=true
MINEWORKS_LOGIN_RATE_LIMIT_ATTEMPTS=8
MINEWORKS_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
MINEWORKS_LOGIN_RATE_LIMIT_BLOCK_MINUTES=15

MINEWORKS_DOCS_ENABLED=true
MINEWORKS_FORCE_HTTPS=false
MINEWORKS_ALLOW_LOCAL_BILLING_SIMULATION=true
